{
  "name": "ryan-meetup-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:meetup": "npm run dev --workspace=@ryanmeetup/meetup",
    "dev:ryancon": "npm run dev --workspace=@ryanmeetup/ryancon",
    "build:meetup": "npm run build --workspace=@ryanmeetup/meetup",
    "build:ryancon": "npm run build --workspace=@ryanmeetup/ryancon",
    "build": "npm run build --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "devDependencies": {
    "vercel": "^54.0.0"
  }
}
